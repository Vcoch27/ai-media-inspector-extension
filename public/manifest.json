{
  "manifest_version": 3,
  "name": "AI Media Inspector",
  "description": "Detect AI-generated images directly on web pages.",
  "version": "0.1.0",
  "action": {
    "default_title": "AI Media Inspector",
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["src/content/content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icons/extensionLogo.png"
  }
}
